<wxs module="wxs" src="./index.wxs"></wxs>

<view
  class="omni-crop-container"
  change:prop="{{wxs.initProps}}"
  prop="{{wxsProps}}"
  bindtouchstart="{{wxs.onTouchStart}}"
  catchtouchmove="{{wxs.onTouchMove}}"
  bindtouchend="{{wxs.onTouchEnd}}"
  bindtouchcancel="{{wxs.onTouchEnd}}"
>
  <!-- Image media layer -->
  <view class="omni-crop-media-wrapper">
    <image
      id="omni-crop-target-image"
      class="omni-crop-media"
      style="{{filterStyle}}"
      src="{{image}}"
      mode="aspectFit"
      bindload="onImageLoaded"
      binderror="onImageError"
    />
  </view>

  <!-- Mask Overlay and Crop Window -->
  <view
    id="omni-crop-overlay-box"
    class="omni-crop-overlay {{cropShape === 'round' ? 'is-round' : ''}}"
    style="width: {{cropSize.width}}px; height: {{cropSize.height}}px;"
  >
    <!-- Grid lines -->
    <block wx:if="{{showGrid}}">
      <view class="omni-crop-grid-container {{showGrid === 'touch' ? (isGridTouching ? 'grid-touch-visible' : 'grid-touch-hidden') : ''}}">
        <view class="omni-crop-grid-line line-horizontal line-h-1"></view>
        <view class="omni-crop-grid-line line-horizontal line-h-2"></view>
        <view class="omni-crop-grid-line line-vertical line-v-1"></view>
        <view class="omni-crop-grid-line line-vertical line-v-2"></view>
      </view>
    </block>

    <!-- 8 Handles for Mode B (free box resizing) -->
    <block wx:if="{{cropMode === 'resize-box'}}">
      <!-- 4 Corner Handles -->
      <view class="omni-crop-corner corner-tl" data-handle="top-left"></view>
      <view class="omni-crop-corner corner-tr" data-handle="top-right"></view>
      <view class="omni-crop-corner corner-bl" data-handle="bottom-left"></view>
      <view class="omni-crop-corner corner-br" data-handle="bottom-right"></view>
      <!-- 4 Edge Handles -->
      <view class="omni-crop-edge edge-t" data-handle="top"></view>
      <view class="omni-crop-edge edge-b" data-handle="bottom"></view>
      <view class="omni-crop-edge edge-l" data-handle="left"></view>
      <view class="omni-crop-edge edge-r" data-handle="right"></view>
    </block>
  </view>
</view>
