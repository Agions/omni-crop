.demo-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #09090b;
  overflow: hidden;
}

/* 顶部信息栏 */
.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 16px;
  background-color: #18181b;
  border-bottom: 1px solid #27272a;
}

.header-title {
  font-size: 15px;
  font-weight: 600;
  color: #fafafa;
}

.header-actions {
  display: flex;
  gap: 8px;
}

.btn-sub {
  margin: 0 !important;
  background: #27272a !important;
  color: #e4e4e7 !important;
  font-size: 12px !important;
  font-weight: 500 !important;
  border-radius: 6px !important;
  border: 1px solid #3f3f46 !important;
  padding: 0 10px !important;
  line-height: 28px !important;
}

/* 裁剪区域主体 */
.cropper-viewport {
  flex: 1;
  position: relative;
  width: 100%;
  background-color: #000;
}

/* 微调角度标尺控制条 */
.fine-angle-bar {
  background-color: #141416;
  padding: 8px 16px;
  border-top: 1px solid #27272a;
  border-bottom: 1px solid #27272a;
}

.angle-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.angle-label {
  font-size: 11px;
  color: #a1a1aa;
}

.angle-badge {
  font-size: 11px;
  color: #38bdf8;
  font-family: monospace;
  font-weight: 600;
}

.angle-badge.snap-active {
  color: #4ade80;
}

.angle-slider-container {
  display: flex;
  align-items: center;
  gap: 8px;
}

.angle-limit {
  font-size: 11px;
  color: #71717a;
  width: 24px;
  text-align: center;
}

.angle-slider {
  flex: 1;
  margin: 0 !important;
}

.angle-reset-btn {
  font-size: 11px;
  color: #e4e4e7;
  background-color: #27272a;
  border: 1px solid #3f3f46;
  border-radius: 4px;
  padding: 2px 6px;
  cursor: pointer;
}

/* 缩放滑块控制条 */
.zoom-slider-bar {
  display: flex;
  align-items: center;
  height: 44px;
  background-color: #ffffff;
  padding: 0 16px;
  border-bottom: 1px solid #e5e7eb;
}

.zoom-symbol {
  font-size: 20px;
  font-weight: 500;
  color: #6b7280;
  width: 26px;
  height: 26px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  user-select: none;
}

.zoom-symbol:active {
  color: #1f2937;
  opacity: 0.7;
}

.slider-track-box {
  flex: 1;
  margin: 0 4px;
}

.zoom-slider {
  margin: 0 !important;
}

.zoom-reset-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-left: 12px;
  padding: 4px 6px;
  color: #4b5563;
  font-size: 12px;
  cursor: pointer;
  user-select: none;
}

.zoom-reset-btn:active {
  opacity: 0.7;
}

.reset-icon {
  font-size: 14px;
  font-weight: bold;
}

.reset-text {
  font-size: 12px;
  color: #4b5563;
}

/* 底部操作面板 */
.control-panel {
  max-height: 240px;
  background-color: #18181b;
  padding: 10px 16px;
  border-top: 1px solid #27272a;
  box-sizing: border-box;
}

.control-group {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-bottom: 8px;
}

.group-label {
  font-size: 12px;
  color: #a1a1aa;
  width: 32px;
  padding-top: 4px;
}

.btn-group {
  display: flex;
  flex: 1;
  gap: 6px;
}

.btn-group.wrap-group {
  flex-wrap: wrap;
}

.pill-btn {
  flex: 1;
  min-width: 48px;
  text-align: center;
  font-size: 11px;
  padding: 5px 6px;
  background-color: #27272a;
  color: #d4d4d8;
  border-radius: 6px;
  border: 1px solid #3f3f46;
  transition: all 0.15s;
}

.pill-btn.active {
  background-color: #2563eb;
  color: #ffffff;
  border-color: #3b82f6;
  font-weight: 600;
}

/* 工具按钮行 */
.tools-row {
  display: flex;
  justify-content: space-around;
  padding: 6px 0;
  border-top: 1px solid #27272a;
  border-bottom: 1px solid #27272a;
  margin: 6px 0;
}

.tool-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 4px 8px;
  border-radius: 6px;
}

.tool-btn:active {
  background-color: #27272a;
}

.tool-icon {
  font-size: 16px;
}

.tool-text {
  font-size: 10px;
  color: #a1a1aa;
}

/* 导出主按钮 */
.btn-export {
  width: 100% !important;
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
  color: #ffffff !important;
  border-radius: 8px !important;
  font-size: 14px !important;
  font-weight: 600 !important;
  line-height: 40px !important;
  margin-top: 4px;
  margin-bottom: 12px;
}

/* 弹窗样式 */
.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.75);
}

.modal-content {
  position: relative;
  z-index: 1001;
  width: 86%;
  background-color: #18181b;
  border: 1px solid #27272a;
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  border-bottom: 1px solid #27272a;
}

.modal-title {
  font-size: 14px;
  font-weight: 600;
  color: #fafafa;
}

.modal-close {
  font-size: 15px;
  color: #71717a;
  padding: 4px;
}

.modal-body {
  padding: 14px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.preview-img {
  width: 220px;
  height: 220px;
  background-color: #09090b;
  border-radius: 8px;
  border: 1px dashed #3f3f46;
}

.preview-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
}

.meta-item {
  font-size: 11px;
  color: #a1a1aa;
}

.modal-footer {
  display: flex;
  padding: 10px 14px;
  gap: 8px;
  border-top: 1px solid #27272a;
}

.btn-save {
  flex: 1 !important;
  background-color: #2563eb !important;
  font-size: 13px !important;
  border-radius: 6px !important;
  line-height: 34px !important;
}

.btn-cancel {
  flex: 1 !important;
  background-color: #27272a !important;
  color: #d4d4d8 !important;
  font-size: 13px !important;
  border-radius: 6px !important;
  line-height: 34px !important;
}

/* 云端参数弹窗 */
.cloud-modal-content {
  width: 90%;
  max-height: 80vh;
}

.cloud-body {
  align-items: stretch;
  gap: 12px;
}

.cloud-info-card {
  background-color: #121214;
  border: 1px solid #27272a;
  border-radius: 8px;
  padding: 10px;
}

.cloud-item-title {
  font-size: 12px;
  font-weight: 600;
  color: #38bdf8;
  margin-bottom: 4px;
}

.code-box {
  background-color: #09090b;
  color: #a1a1aa;
  font-family: monospace;
  font-size: 11px;
  padding: 6px 8px;
  border-radius: 4px;
  word-break: break-all;
  margin-bottom: 6px;
}

.btn-copy-small {
  margin: 0 !important;
  font-size: 11px !important;
  background-color: #27272a !important;
  color: #e4e4e7 !important;
  border: 1px solid #3f3f46 !important;
  line-height: 24px !important;
}
