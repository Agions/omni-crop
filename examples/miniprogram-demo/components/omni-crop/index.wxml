<wxs module="wxs" src="./index.wxs"></wxs>

<view
  class="omni-crop-container"
  change:prop="{{wxs.initProps}}"
  prop="{{wxsProps}}"
  bindtouchstart="{{wxs.onTouchStart}}"
  catchtouchmove="{{wxs.onTouchMove}}"
  bindtouchend="{{wxs.onTouchEnd}}"
  bindtouchcancel="{{wxs.onTouchEnd}}"
>
  <!-- 图片主体层 -->
  <view class="omni-crop-media-wrapper">
    <image
      id="omni-crop-target-image"
      class="omni-crop-media"
      src="{{image}}"
      mode="aspectFit"
      bindload="onImageLoaded"
      binderror="onImageError"
    />
  </view>

  <!-- 裁剪框与半透明遮罩 -->
  <view
    class="omni-crop-overlay {{cropShape === 'round' ? 'is-round' : ''}}"
    style="width: {{cropSize.width}}px; height: {{cropSize.height}}px;"
  >
    <!-- 九宫格参考线 -->
    <block wx:if="{{showGrid}}">
      <view class="omni-crop-grid-line line-horizontal line-h-1"></view>
      <view class="omni-crop-grid-line line-horizontal line-h-2"></view>
      <view class="omni-crop-grid-line line-vertical line-v-1"></view>
      <view class="omni-crop-grid-line line-vertical line-v-2"></view>
    </block>

    <!-- 模式 B 角标 (四角拖拽把手) -->
    <block wx:if="{{cropMode === 'resize-box'}}">
      <view class="omni-crop-corner corner-tl"></view>
      <view class="omni-crop-corner corner-tr"></view>
      <view class="omni-crop-corner corner-bl"></view>
      <view class="omni-crop-corner corner-br"></view>
    </block>
  </view>
</view>
