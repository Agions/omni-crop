.omni-crop-container {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
  touch-action: none;
}

.omni-crop-media-wrapper {
  position: absolute;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.omni-crop-media {
  will-change: transform;
  transform-origin: center center;
  pointer-events: none;
}

/* Mask Overlay */
.omni-crop-overlay {
  position: absolute;
  box-sizing: border-box;
  border: 1.5px solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.65);
  pointer-events: none;
  will-change: width, height, transform;
}

.omni-crop-overlay.is-round {
  border-radius: 50%;
}

/* Grid container and lines */
.omni-crop-grid-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  transition: opacity 0.35s ease;
}

.grid-touch-hidden {
  opacity: 0;
}

.grid-touch-visible {
  opacity: 1;
}

.omni-crop-grid-line {
  position: absolute;
  background-color: rgba(255, 255, 255, 0.35);
}

.line-horizontal {
  width: 100%;
  height: 1px;
}

.line-h-1 {
  top: 33.33%;
}

.line-h-2 {
  top: 66.66%;
}

.line-vertical {
  height: 100%;
  width: 1px;
}

.line-v-1 {
  left: 33.33%;
}

.line-v-2 {
  left: 66.66%;
}

/* Mode B Corner handles */
.omni-crop-corner {
  position: absolute;
  width: 18px;
  height: 18px;
  border-color: #ffffff;
  border-style: solid;
  pointer-events: auto;
  z-index: 10;
}

/* 32px invisible hit area for corners */
.omni-crop-corner::after {
  content: '';
  position: absolute;
  width: 36px;
  height: 36px;
  pointer-events: auto;
}

.corner-tl {
  top: -2px;
  left: -2px;
  border-width: 3px 0 0 3px;
}
.corner-tl::after {
  top: -10px;
  left: -10px;
}

.corner-tr {
  top: -2px;
  right: -2px;
  border-width: 3px 3px 0 0;
}
.corner-tr::after {
  top: -10px;
  right: -10px;
}

.corner-bl {
  bottom: -2px;
  left: -2px;
  border-width: 0 0 3px 3px;
}
.corner-bl::after {
  bottom: -10px;
  left: -10px;
}

.corner-br {
  bottom: -2px;
  right: -2px;
  border-width: 0 3px 3px 0;
}
.corner-br::after {
  bottom: -10px;
  right: -10px;
}

/* Mode B Edge handles (pill bars) */
.omni-crop-edge {
  position: absolute;
  background-color: rgba(255, 255, 255, 0.95);
  pointer-events: auto;
  z-index: 9;
}

/* 32px invisible hit area for edges */
.omni-crop-edge::after {
  content: '';
  position: absolute;
  pointer-events: auto;
}

.edge-t {
  top: -2px;
  left: 50%;
  transform: translateX(-50%);
  width: 24px;
  height: 3px;
  border-radius: 2px;
}
.edge-t::after {
  top: -14px;
  left: -10px;
  width: 44px;
  height: 32px;
}

.edge-b {
  bottom: -2px;
  left: 50%;
  transform: translateX(-50%);
  width: 24px;
  height: 3px;
  border-radius: 2px;
}
.edge-b::after {
  bottom: -14px;
  left: -10px;
  width: 44px;
  height: 32px;
}

.edge-l {
  left: -2px;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 24px;
  border-radius: 2px;
}
.edge-l::after {
  left: -14px;
  top: -10px;
  width: 32px;
  height: 44px;
}

.edge-r {
  right: -2px;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 24px;
  border-radius: 2px;
}
.edge-r::after {
  right: -14px;
  top: -10px;
  width: 32px;
  height: 44px;
}
